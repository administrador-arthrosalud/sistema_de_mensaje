# Base local de la aplicación (PostgreSQL). Nunca la base de SIGES.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=siges_dashboard
DB_USER=siges_app
DB_PASSWORD=cambia-esta-clave
DB_SSLMODE=prefer
APP_TIMEZONE=America/Lima

SIGES_SYNC_DB_USER=siges_sync
SIGES_SYNC_DB_PASSWORD=cambia-esta-clave-tambien

SIGES_PG_HOST=127.0.0.1
SIGES_PG_PORT=15432
SIGES_PG_DATABASE=cambia-por-la-base-siges
SIGES_PG_USER=cambia-por-un-rol-de-solo-lectura
SIGES_PG_PASSWORD=cambia-esta-clave
SIGES_PG_SSLMODE=disable

CHATBOT_BASE_URL=https://chatbot.gestionalo.pe
CHATBOT_LINE_KEY=serie_asignada_a_la_linea
CHATBOT_COUNTRY_CODE=51
CHATBOT_WEBHOOK_TOKEN=genera-un-token-largo-y-aleatorio

# Solo para docker-compose.yml (contenedor PostgreSQL local). Deben coincidir
# con DB_PASSWORD (siges_app) y SIGES_SYNC_DB_PASSWORD (siges_sync).
POSTGRES_PASSWORD=cambia-esta-clave
SIGES_APP_PASSWORD=cambia-esta-clave
SIGES_SYNC_PASSWORD=cambia-esta-clave-tambien

# Opcionales de docker-compose.yml (valores por defecto entre paréntesis).
# DB_PUBLISH_PORT=15433            # puerto local de la base (5432); cámbialo si SIGES usa 5432 en el mismo servidor
# WEB_PUBLISH_PORT=8082            # puerto local de la aplicación web (8082)
# SIGES_PG_HOST=192.168.1.253      # host de SIGES visto desde Docker (host.docker.internal)
# DOCKER_SUBNET=172.28.0.0/24      # subred de la red Docker (172.28.0.0/24)
# DOCKER_GATEWAY_IP=172.28.0.1     # su puerta de enlace; también la acepta el filtro de acceso (172.28.0.1)

# Solo para scripts/migrate-mysql-to-postgresql.php (copia única desde la base MySQL anterior).
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_NAME=siges_dashboard
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASSWORD=cambia-esta-clave
PG_MIGRATION_USER=postgres
PG_MIGRATION_PASSWORD=cambia-esta-clave
